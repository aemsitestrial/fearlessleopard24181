{
  "definitions": [
    {
      "title": "Badge",
      "id": "badge",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Badge",
              "filter": "badge"
            }
          }
        }
      }
    },
    {
      "title": "Badge Item",
      "id": "badge-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Badge Item",
              "model": "badge-item",
              "label": "New",
              "variant": "primary"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "badge-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "description": "The text displayed inside the badge.",
          "required": true
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "variant",
          "label": "Variant",
          "description": "Visual style of the badge.",
